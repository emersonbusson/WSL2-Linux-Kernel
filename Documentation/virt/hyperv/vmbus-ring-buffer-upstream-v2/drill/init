#!/bin/sh
# PID 1 of the disposable VMBus drill guest.
#
# Boots from a single bzImage with the initramfs embedded. There is no distro,
# no disk root, and no second stage: this mounts the kernel's own filesystems,
# inventories VMBus, runs the lifecycle and fragmentation drills against the
# exact candidate bytes, prints a machine-readable verdict on the serial
# console, and powers the VM off.
#
# The host-safety contract of the drills is preserved by construction: this
# guest exists only to be drilled and is deleted when the job ends. It is
# never the daily WSL2 host, never holds anything worth keeping, and never
# activates swap.
#
# Output contract (the host harness greps these):
#   HYPERV_DRILL_BOOT kernel=<release>
#   HYPERV_DRILL_VMBUS present=<yes/no> devices=<n>
#   HYPERV_DRILL_SYMBOLS alloc=<n>
#   HYPERV_DRILL_NIC id=<...>
#   HYPERV_DRILL_LIFECYCLE status=<...>
#   HYPERV_DRILL_FRAGMENT status=<...>
#   HYPERV_DRILL_SPLATS count=<n>
#   HYPERV_DRILL_RESULT status=<PASS|FAIL>
#   HYPERV_DRILL_REPORT ... (replicated, indexed, SHA-256-bound evidence)
#   HYPERV_DRILL_DONE

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/
umask 022

echo "HYPERV_DRILL_INIT begin"

# --- filesystems -------------------------------------------------------------
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /var/tmp 2>/dev/null
mkdir -p /dev/shm /run
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
mount -t tracefs tracefs /sys/kernel/tracing 2>/dev/null

# Serial console: make sure the UEFI stub's console=ttyS0 actually shows up.
if [ -c /dev/console ]; then
	exec >/dev/console 2>/dev/console
fi
if [ -c /dev/ttyS0 ]; then
	exec >/dev/ttyS0 2>/dev/ttyS0
fi

# Power off only after the serial port has drained what we already wrote.
# echo's write(2) returns when the tty layer accepts the bytes, not when the
# UART has shifted them out, and printk reaches the same port through a
# different path. Triggering sysrq while verdict bytes are still in the FIFO
# lets `sysrq: Power Off` land mid-line and split the one line the host
# harness matches on: run 36808657969 (windows-latest) reported NO_RESULT
# from a guest that had printed `HYPERV_DRILL_RESULT ... status=PARTIAL`.
# Closing the userspace writer first means only printk can emit afterwards,
# and the verdict is already complete and on the wire.
drain_and_poweroff() {
	exec >/dev/null 2>/dev/null
	sleep 2
	sync
	echo o >/proc/sysrq-trigger 2>/dev/null
	poweroff -f 2>/dev/null
	reboot -f 2>/dev/null
	exit 0
}

# The status line is short and repeated three times so a single printk
# split cannot take every copy of the token the host greps for.
emit_status() {
	printf '%s\n' "HYPERV_DRILL_RESULT status=$1"
	printf '%s\n' "HYPERV_DRILL_RESULT status=$1"
	printf '%s\n' "HYPERV_DRILL_RESULT status=$1"
}

echo "HYPERV_DRILL_BOOT kernel=$(uname -r)"
echo "HYPERV_DRILL_BOOT cmdline=$(tr -d '\n' </proc/cmdline)"

# --- VMBus inventory ---------------------------------------------------------
if [ -d /sys/bus/vmbus ]; then
	VMBUS_PRESENT=yes
	VMBUS_DEVICES=$(ls /sys/bus/vmbus/devices 2>/dev/null | wc -l)
else
	VMBUS_PRESENT=no
	VMBUS_DEVICES=0
fi
echo "HYPERV_DRILL_VMBUS present=$VMBUS_PRESENT devices=$VMBUS_DEVICES"

if [ "$VMBUS_PRESENT" = yes ]; then
	# Class ids only. Device instance ids are host-assigned and uninteresting,
	# so they are deliberately not printed. The attribute is class_id (with an
	# underscore); classid does not exist and silently yields an empty field.
	for d in /sys/bus/vmbus/devices/*; do
		[ -e "$d" ] || continue
		cls=$(cat "$d/class_id" 2>/dev/null)
		echo "HYPERV_DRILL_DEVICE class_id=$cls"
	done
fi

SYMS=$(grep -cE 'vmbus_(alloc|free|release)_buffer' /proc/kallsyms 2>/dev/null)
echo "HYPERV_DRILL_SYMBOLS alloc=${SYMS:-0}"

if [ "$VMBUS_PRESENT" != yes ] || [ "${VMBUS_DEVICES:-0}" -eq 0 ]; then
	emit_status FAIL
	echo "HYPERV_DRILL_RESULT reason=no_vmbus"
	echo "HYPERV_DRILL_DONE"
	drain_and_poweroff
fi

# --- synthetic NIC discovery -------------------------------------------------
# The instance id is host-assigned and differs on every VM. Discover it from
# the driver binding instead of hardcoding a GUID.
NIC=""
for d in /sys/bus/vmbus/drivers/hv_netvsc/*; do
	[ -e "$d" ] || continue
	n=$(basename "$d")
	case "$n" in
	bind | unbind | uevent | module | new_id | remove_id) continue ;;
	esac
	if [ -d "$d" ]; then
		NIC="$n"
		break
	fi
done
echo "HYPERV_DRILL_NIC id=${NIC:-none}"

# --- shared helpers ----------------------------------------------------------
vmbus_maps() {
	awk '
		/vmbus_alloc_buffer/ {
			n++
			total += $2
			for (i = 1; i <= NF; i++) {
				if ($i ~ /^pages=/) {
					split($i, p, "=")
					pages += p[2]
				}
			}
		}
		END { printf "MAPS count=%d bytes=%d pages=%d\n", n, total, pages }
	' /proc/vmallocinfo 2>/dev/null
}

splat_count() {
	dmesg 2>/dev/null |
		grep -cE 'BUG:|Oops:|panic:|Kernel panic|WARNING:|hung task|Unable to handle|general protection|Out of memory|Memory cgroup out of memory|oom-kill:'
}

# A guest phase marker uses only shell builtins. In particular, it must
# remain available while fragmentation leaves no memory for another fork.
phase_marker() {
	read -r phase_uptime phase_idle </proc/uptime
	printf 'HYPERV_DRILL_PHASE name=%s event=%s uptime_s=%s\n' "$1" "$2" "$phase_uptime"
}

# --- drills ------------------------------------------------------------------
# Fragmentation runs FIRST. The BUG-3 hold-in-mmap in the lifecycle drill
# leaves the synthetic NIC's channel in CHANNEL_OPENED_STATE: uio_hv_generic
# disconnects the channel on the last close of /dev/uio0, but its .remove does
# not, so unbinding the driver while a helper still holds that fd never calls
# vmbus_disconnect_ring and __vmbus_open() then rejects the rebind with
# -EINVAL. That is pre-existing upstream behaviour (drivers/uio/uio_hv_generic.c
# is unchanged from the base at hv_uio_remove), and it is not a fragmentation
# result -- run 36803317912 reproduced it on a healthy buddy at t=5.2s. Running
# the channel-open exercise afterwards would therefore be measuring the UIO
# lifecycle, not the ring allocation, and PASS_RING_ALLOCATION_UNDER_FRAGMENTATION
# would be unreachable. Give the fragmentation drill a boot-clean NIC and let
# the lifecycle drill consume the channel afterwards.
HELPER=/bin/vmbus_drill_helper
LIFECYCLE_STATUS=skipped
FRAG_STATUS=skipped

if [ -n "$NIC" ] && [ -x "$HELPER" ]; then
	export NIC
	phase_marker fragmentation begin
	FRAG_ORIG_MAX_MAP_COUNT=
	FRAG_ORIG_MIN_FREE_KB=
	FRAG_ORIG_BOOST_FACTOR=
	FRAG_VM_STATE_VALID=yes
	# BusyBox ash returns nonzero when read reaches EOF without a trailing
	# newline, even though it has assigned the complete proc-sysctl value.
	# Accept that case only when a nonempty value was read, then validate all
	# three values as unsigned decimal before allowing the fallback restore.
	read -r FRAG_ORIG_MAX_MAP_COUNT </proc/sys/vm/max_map_count || [ -n "$FRAG_ORIG_MAX_MAP_COUNT" ] || FRAG_VM_STATE_VALID=no
	read -r FRAG_ORIG_MIN_FREE_KB </proc/sys/vm/min_free_kbytes || [ -n "$FRAG_ORIG_MIN_FREE_KB" ] || FRAG_VM_STATE_VALID=no
	read -r FRAG_ORIG_BOOST_FACTOR </proc/sys/vm/watermark_boost_factor || [ -n "$FRAG_ORIG_BOOST_FACTOR" ] || FRAG_VM_STATE_VALID=no
	case $FRAG_ORIG_MAX_MAP_COUNT in '' | *[!0-9]*) FRAG_VM_STATE_VALID=no ;; esac
	case $FRAG_ORIG_MIN_FREE_KB in '' | *[!0-9]*) FRAG_VM_STATE_VALID=no ;; esac
	case $FRAG_ORIG_BOOST_FACTOR in '' | *[!0-9]*) FRAG_VM_STATE_VALID=no ;; esac
	echo "FRAGMENT_INIT_SNAPSHOT max_map_count=$FRAG_ORIG_MAX_MAP_COUNT min_free_kbytes=$FRAG_ORIG_MIN_FREE_KB watermark_boost_factor=$FRAG_ORIG_BOOST_FACTOR valid=$FRAG_VM_STATE_VALID"
	# MemTotal, not a share of what looks free: the helper treats this as a
	# ceiling the allocation loop must never reach. A 75% share stopped with
	# untouched order-10 blocks before meeting the 99% pressure threshold.
	# MemTotal is above what this guest can allocate; the helper's measured
	# order-7 reserve and memory margins decide when to stop.
	FRAG_HOG=$(awk '/MemTotal/{print int($2 / 1024)}' /proc/meminfo)
	echo "HYPERV_DRILL_FRAGMENT hog_mib=${FRAG_HOG:-0}"
	sh /scripts/vmbus-fragmentation-drill.sh "${FRAG_HOG:-512}" /var/tmp/fragment.log
	FRAG_STATUS=$?
	# The helper writes its PID before changing any global VM setting. If the
	# drill shell was OOM-killed, it is reparented here and receives its
	# PR_SET_PDEATHSIG cleanup signal; wait before allowing lifecycle work.
	FRAG_HELPER_PID=
	FRAG_HELPER_PID_FILE=/var/tmp/fragment.log.helper.pid
	if read -r FRAG_HELPER_PID <"$FRAG_HELPER_PID_FILE" 2>/dev/null; then
		case "$FRAG_HELPER_PID" in
		'' | *[!0-9]*) FRAG_HELPER_PID= ;;
		esac
		if [ -n "$FRAG_HELPER_PID" ] && [ "$FRAG_HELPER_PID" -gt 1 ]; then
			wait "$FRAG_HELPER_PID" 2>/dev/null || true
		fi
	fi
	rm -f "$FRAG_HELPER_PID_FILE"
	FRAG_CURRENT_MAX_MAP_COUNT=unknown
	FRAG_CURRENT_MIN_FREE_KB=unknown
	FRAG_CURRENT_BOOST_FACTOR=unknown
	read -r FRAG_CURRENT_MAX_MAP_COUNT </proc/sys/vm/max_map_count || true
	read -r FRAG_CURRENT_MIN_FREE_KB </proc/sys/vm/min_free_kbytes || true
	read -r FRAG_CURRENT_BOOST_FACTOR </proc/sys/vm/watermark_boost_factor || true
	FRAG_GLOBAL_RESTORE_NEEDED=no
	if [ "$FRAG_VM_STATE_VALID" = yes ]; then
		if [ "$FRAG_CURRENT_MAX_MAP_COUNT" != "$FRAG_ORIG_MAX_MAP_COUNT" ]; then
			FRAG_GLOBAL_RESTORE_NEEDED=yes
			printf '%s\n' "$FRAG_ORIG_MAX_MAP_COUNT" >/proc/sys/vm/max_map_count 2>/dev/null || true
		fi
		if [ "$FRAG_CURRENT_MIN_FREE_KB" != "$FRAG_ORIG_MIN_FREE_KB" ]; then
			FRAG_GLOBAL_RESTORE_NEEDED=yes
			printf '%s\n' "$FRAG_ORIG_MIN_FREE_KB" >/proc/sys/vm/min_free_kbytes 2>/dev/null || true
		fi
		if [ "$FRAG_CURRENT_BOOST_FACTOR" != "$FRAG_ORIG_BOOST_FACTOR" ]; then
			FRAG_GLOBAL_RESTORE_NEEDED=yes
			printf '%s\n' "$FRAG_ORIG_BOOST_FACTOR" >/proc/sys/vm/watermark_boost_factor 2>/dev/null || true
		fi
		read -r FRAG_CURRENT_MAX_MAP_COUNT </proc/sys/vm/max_map_count || true
		read -r FRAG_CURRENT_MIN_FREE_KB </proc/sys/vm/min_free_kbytes || true
		read -r FRAG_CURRENT_BOOST_FACTOR </proc/sys/vm/watermark_boost_factor || true
		if [ "$FRAG_CURRENT_MAX_MAP_COUNT" = "$FRAG_ORIG_MAX_MAP_COUNT" ] &&
			[ "$FRAG_CURRENT_MIN_FREE_KB" = "$FRAG_ORIG_MIN_FREE_KB" ] &&
			[ "$FRAG_CURRENT_BOOST_FACTOR" = "$FRAG_ORIG_BOOST_FACTOR" ]; then
			echo "FRAGMENT_INIT_RESTORE max_map_count=$FRAG_CURRENT_MAX_MAP_COUNT min_free_kbytes=$FRAG_CURRENT_MIN_FREE_KB watermark_boost_factor=$FRAG_CURRENT_BOOST_FACTOR fallback=$FRAG_GLOBAL_RESTORE_NEEDED verified=yes" >>/var/tmp/fragment.log
			if [ "$FRAG_GLOBAL_RESTORE_NEEDED" = yes ]; then
				FRAG_STATUS=1
			fi
		else
			echo "FRAGMENT_INIT_RESTORE max_map_count=$FRAG_CURRENT_MAX_MAP_COUNT min_free_kbytes=$FRAG_CURRENT_MIN_FREE_KB watermark_boost_factor=$FRAG_CURRENT_BOOST_FACTOR verified=no" >>/var/tmp/fragment.log
			FRAG_STATUS=1
		fi
	else
		echo "FRAGMENT_INIT_RESTORE verified=no reason=initial-state-unavailable" >>/var/tmp/fragment.log
		FRAG_STATUS=1
	fi
	phase_marker fragmentation end
	echo "HYPERV_DRILL_FRAGMENT status=$FRAG_STATUS"
	# A signal death (137 is SIGKILL) still fails the runtime verdict. The
	# helper PID barrier and state check above make lifecycle safe to start
	# only after pressure is gone and the original global VM values are back.
	if [ "${FRAG_STATUS:-0}" -gt 3 ] 2>/dev/null; then
		echo "HYPERV_DRILL_MAPS after_fragment skipped=signal status=$FRAG_STATUS"
	else
		echo "HYPERV_DRILL_MAPS after_fragment $(vmbus_maps)"
	fi
else
	echo "HYPERV_DRILL_FRAGMENT status=skipped reason=${NIC:+no_helper}${NIC:-no_nic}"
fi

if [ -n "$NIC" ] && [ -x "$HELPER" ]; then
	export NIC
	phase_marker lifecycle begin
	# 100 cycles is the SPEC count (vmbus_channel_lifecycle_buffer_balance)
	# and the PRD acceptance criterion: "100 normal channel open/close
	# cycles leave no unexplained mapping growth". 30 measured that for a
	# third of the required sample and cannot close the gate.
	sh /scripts/vmbus-lifecycle-drill.sh 100 /var/tmp/lifecycle.log
	LIFECYCLE_STATUS=$?
	phase_marker lifecycle end
	echo "HYPERV_DRILL_LIFECYCLE status=$LIFECYCLE_STATUS"
	# Same rule as after_fragment: a signal death must not provoke a fork
	# while the helper's teardown may still be reclaiming.
	if [ "${LIFECYCLE_STATUS:-0}" -gt 3 ] 2>/dev/null; then
		echo "HYPERV_DRILL_MAPS after_lifecycle skipped=signal status=$LIFECYCLE_STATUS"
	else
		echo "HYPERV_DRILL_MAPS after_lifecycle $(vmbus_maps)"
	fi
else
	echo "HYPERV_DRILL_LIFECYCLE status=skipped reason=${NIC:+no_helper}${NIC:-no_nic}"
fi

# Optional real host removal, after the independently scored lifecycle.
HOST_RESCIND_STATUS=skipped
HOST_EVENTS=0
if grep -qw 'hyperv_drill_host_rescind=1' /proc/cmdline; then
	HOST_RESCIND_STATUS=PARTIAL
	if [ "$LIFECYCLE_STATUS" = 0 ] && [ -n "$NIC" ] &&
		[ -d "/sys/bus/vmbus/devices/$NIC" ]; then
		read -r HOST_RELID <"/sys/bus/vmbus/devices/$NIC/id"
		TRACE_DIR=/sys/kernel/tracing
		echo 1 >"$TRACE_DIR/events/hyperv/vmbus_onoffer_rescind/enable"
		phase_marker host_rescind begin
		# The host acts only after this exact readiness marker.
		for HOST_READY_COPY in 1 2 3; do
			echo "HOST_RESCIND_READY relid=$HOST_RELID"
		done
		HOST_WAIT=0
		while [ -d "/sys/bus/vmbus/devices/$NIC" ] && [ "$HOST_WAIT" -lt 60 ]; do
			sleep 1
			HOST_WAIT=$((HOST_WAIT + 1))
		done
		sleep 1
		HOST_HEX=$(printf '%x' "$HOST_RELID")
		HOST_EVENTS=$(grep -c "vmbus_onoffer_rescind: child_relid 0x$HOST_HEX$" "$TRACE_DIR/trace")
		if [ ! -d "/sys/bus/vmbus/devices/$NIC" ] && [ "${HOST_EVENTS:-0}" -gt 0 ]; then
			HOST_RESCIND_STATUS=PASS
		fi
		echo "HOST_RESCIND_VERDICT=$HOST_RESCIND_STATUS target_absent=$([ ! -d "/sys/bus/vmbus/devices/$NIC" ] && echo yes || echo no) matching_events=${HOST_EVENTS:-0} waited_s=$HOST_WAIT"
		phase_marker host_rescind end
	else
		echo 'HOST_RESCIND_VERDICT=PARTIAL reason=lifecycle-or-device-unavailable'
	fi
fi

# --- final scan --------------------------------------------------------------
SPLATS=$(splat_count)
echo "HYPERV_DRILL_SPLATS count=${SPLATS:-0}"

# Deliberately excludes `order:7` and `page allocation failure`: those are the
# proof that the fragmentation drill actually applied pressure, and the drill
# scores them itself. Counting them here would FAIL a successful fallback.
# What counts as damage is a splat or the channel-open regression signature.
FAULTS=$(dmesg 2>/dev/null |
	grep -cE 'BUG:|Oops:|panic:|Kernel panic|Out of memory|Memory cgroup out of memory|oom-kill:|accept4 failed|hung task|Unable to handle|general protection')
echo "HYPERV_DRILL_FAULTS count=${FAULTS:-0}"

# Print only opaque owner-event payloads. Capture starts from the boot
# command line; enabling the event here would miss boot allocations. A
# missing event or any per-CPU ring overrun leaves owner accounting partial.
TRACE_DIR=/sys/kernel/tracing
OWNER_CAPTURE=/var/tmp/owner-events.txt
(
if [ "$(cat "$TRACE_DIR/events/hyperv/vmbus_buffer_owner/enable" 2>/dev/null)" = 1 ] &&
	grep -q 'trace_event=hyperv:vmbus_buffer_owner' /proc/cmdline; then
	echo 0 >"$TRACE_DIR/tracing_on"
	if OWNER_STATS=$(awk '
		$1 == "overrun:" { n += $2; cpus++ }
		$1 == "commit" && $2 == "overrun:" { n += $3 }
		$1 == "dropped" && $2 == "events:" { d += $3; dc++ }
		END {
			if (!cpus || cpus != dc) exit 1
			printf "overruns=%d dropped=%d stats_cpus=%d", n, d, cpus
		}' "$TRACE_DIR"/per_cpu/cpu*/stats); then
		echo "OWNER_TRACE $OWNER_STATS capture=boot_to_quiescence"
	else
		echo "OWNER_TRACE status=UNAVAILABLE reason=missing_stats"
	fi
	awk '/vmbus_buffer_owner: owner_id=/ { sub(/^.*vmbus_buffer_owner: /, "vmbus_buffer_owner: "); print }' "$TRACE_DIR/trace"
	echo "OWNER_TRACE end=1"
else
	echo "OWNER_TRACE status=UNAVAILABLE"
fi
) >"$OWNER_CAPTURE"
# The serial path has dropped individual characters in large plain-text
# dumps despite zero ftrace overruns. Compress the opaque payload and bind
# every received byte to its digest; an incomplete transfer stays PARTIAL.
if gzip -c "$OWNER_CAPTURE" >"$OWNER_CAPTURE.gz"; then
	read -r OWNER_DIGEST OWNER_UNUSED <<EOF
$(sha256sum "$OWNER_CAPTURE.gz")
EOF
	base64 "$OWNER_CAPTURE.gz" >"$OWNER_CAPTURE.b64"
	OWNER_ROWS=$(wc -l <"$OWNER_CAPTURE.b64")
	# Numbered replicas recover serial loss only after the entire packed
	# payload verifies against its digest; no kernel event is inferred.
	for OWNER_COPY in 1 2 3; do
		echo "OWNER_TRACE_BLOB format=gzip-base64-indexed rows=$OWNER_ROWS sha256=$OWNER_DIGEST"
		OWNER_INDEX=0
		while IFS= read -r OWNER_ROW; do
			printf 'OWNER_TRACE_DATA index=%s data=%s\n' "$OWNER_INDEX" "$OWNER_ROW"
			OWNER_INDEX=$((OWNER_INDEX + 1))
			sleep 0.02
		done <"$OWNER_CAPTURE.b64"
		echo "OWNER_TRACE_BLOB end=1"
	done
else
	echo "OWNER_TRACE status=UNAVAILABLE reason=serialization_failed"
fi

# --- verdict -----------------------------------------------------------------
# Drill exit codes:
#   0  PASS         the drill ran its stress path cleanly
#   1  FAIL         candidate damage, or the exercise could not run
#   2  REFUSE       a guard tripped. Inside this guest that is a wiring fault,
#                   not a host-safety refusal: this guest IS the disposable one.
#   3  INCONCLUSIVE (fragmentation only) measurement ran but pressure was
#                   insufficient. Not a failure, and not a gate closure.
#
# PASS requires a real VMBus guest, the candidate symbols present, a clean
# dmesg, and every drill that ran to have run cleanly. INCONCLUSIVE is green
# for the job and PARTIAL for the gate. A refused or failed drill is FAIL.
RESULT=FAIL
SCOPE=none
if [ "$VMBUS_PRESENT" = yes ] &&
	[ "${SYMS:-0}" -gt 0 ] &&
	[ "${SPLATS:-0}" -eq 0 ] &&
	[ "${FAULTS:-0}" -eq 0 ]; then
	if [ "$LIFECYCLE_STATUS" = 0 ] && [ "$FRAG_STATUS" = 0 ]; then
		RESULT=PASS
		SCOPE=ordinary-hyperv-gpadl-uio-and-ring-under-fragmentation
	elif [ "$LIFECYCLE_STATUS" = 0 ] && [ "$FRAG_STATUS" = 3 ]; then
		RESULT=PARTIAL
		SCOPE=lifecycle-pass-fragment-inconclusive
	elif [ "$LIFECYCLE_STATUS" = 3 ]; then
		# Lifecycle exited 3: the exercise ran but a required
		# measurement was unavailable (map accounting unreadable, or
		# the pre-UIO tuple was not sampled), so the run is unqualified
		# rather than failed. Never fold this into FAIL -- that would
		# read as candidate damage -- and never into PASS -- absent
		# data is not balanced data.
		RESULT=PARTIAL
		SCOPE=lifecycle-inconclusive
	fi
fi
if [ "$LIFECYCLE_STATUS" = 2 ] || [ "$FRAG_STATUS" = 2 ]; then
	RESULT=FAIL
	SCOPE=drill-refused
fi
if [ "$LIFECYCLE_STATUS" = 1 ] || [ "$FRAG_STATUS" = 1 ]; then
	RESULT=FAIL
	SCOPE=drill-failed
fi
# Statuses outside the documented 0..3 set mean the drill died on a
# signal instead of reporting (137 is SIGKILL). The measurement did
# not complete: still FAIL, but say so rather than leaving scope=none
# to read as candidate damage.
if [ "${LIFECYCLE_STATUS:-0}" -gt 3 ] 2>/dev/null ||
	[ "${FRAG_STATUS:-0}" -gt 3 ] 2>/dev/null; then
	RESULT=FAIL
	SCOPE=drill-killed
fi

if [ "$HOST_RESCIND_STATUS" = PARTIAL ] && [ "$RESULT" = PASS ]; then
	RESULT=PARTIAL
	SCOPE=host-rescind-unobserved
fi

# The live serial console can lose individual characters while the guest is
# busy. Preserve the decision-bearing report and both drill logs in one
# checksummed payload, then send seven indexed copies in short rows, rotating
# row order between copies to decorrelate burst loss. A strict majority is
# required for every row, and the host verifies the SHA-256 over the compressed
# bytes; the raw console remains useful for progress/debugging but is no longer
# the authority for a runtime verdict.
HOST_TARGET_ABSENT=no
if [ -z "$NIC" ] || [ ! -d "/sys/bus/vmbus/devices/$NIC" ]; then
	HOST_TARGET_ABSENT=yes
fi
DRILL_REPORT=/var/tmp/hyperv-drill-report.txt
{
	echo "HYPERV_DRILL_EVIDENCE schema=1"
	echo "HYPERV_DRILL_BOOT kernel=$(uname -r)"
	echo "HYPERV_DRILL_VMBUS present=$VMBUS_PRESENT devices=$VMBUS_DEVICES"
	echo "HYPERV_DRILL_SYMBOLS alloc=${SYMS:-0}"
	echo "HYPERV_DRILL_NIC present=$([ -n "$NIC" ] && echo yes || echo no)"
	echo "HYPERV_DRILL_FRAGMENT status=$FRAG_STATUS"
	echo "HYPERV_DRILL_LIFECYCLE status=$LIFECYCLE_STATUS"
	echo "HYPERV_DRILL_HOST_RESCIND status=$HOST_RESCIND_STATUS target_absent=$HOST_TARGET_ABSENT matching_events=$HOST_EVENTS"
	echo "HYPERV_DRILL_SPLATS count=${SPLATS:-0}"
	echo "HYPERV_DRILL_FAULTS count=${FAULTS:-0}"
	for REPORT_STATUS_COPY in 1 2 3; do
		echo "HYPERV_DRILL_RESULT status=$RESULT"
	done
	echo "HYPERV_DRILL_RESULT lifecycle=$LIFECYCLE_STATUS fragment=$FRAG_STATUS splats=${SPLATS:-0} faults=${FAULTS:-0}"
	echo "HYPERV_DRILL_RESULT scope=$SCOPE"
	echo '--- FRAGMENTATION LOG BEGIN ---'
	if [ -r /var/tmp/fragment.log ]; then cat /var/tmp/fragment.log; fi
	echo '--- FRAGMENTATION LOG END ---'
	echo '--- LIFECYCLE LOG BEGIN ---'
	if [ -r /var/tmp/lifecycle.log ]; then cat /var/tmp/lifecycle.log; fi
	echo '--- LIFECYCLE LOG END ---'
	echo 'HYPERV_DRILL_EVIDENCE_END'
} >"$DRILL_REPORT"

if gzip -c "$DRILL_REPORT" >"$DRILL_REPORT.gz"; then
	read -r REPORT_DIGEST REPORT_UNUSED <<EOF
$(sha256sum "$DRILL_REPORT.gz")
EOF
	base64 "$DRILL_REPORT.gz" >"$DRILL_REPORT.b64"
	REPORT_WIDTH=40
	REPORT_COPIES=7
	awk -v width="$REPORT_WIDTH" '
		{ encoded = encoded $0 }
		END {
			row_index = 0
			for (offset = 1; offset <= length(encoded); offset += width) {
				print row_index, substr(encoded, offset, width)
				row_index++
			}
		}' "$DRILL_REPORT.b64" >"$DRILL_REPORT.rows"
	REPORT_ROWS=$(awk 'END { print NR + 0 }' "$DRILL_REPORT.rows")
	if [ "$REPORT_ROWS" -gt 0 ]; then
		REPORT_COPY=0
		while [ "$REPORT_COPY" -lt "$REPORT_COPIES" ]; do
			echo "HYPERV_DRILL_REPORT format=gzip-base64-indexed-v2 width=$REPORT_WIDTH copies=$REPORT_COPIES rows=$REPORT_ROWS sha256=$REPORT_DIGEST"
			REPORT_START=$((REPORT_COPY * REPORT_ROWS / REPORT_COPIES))
			awk -v start="$REPORT_START" -v count="$REPORT_ROWS" '
				{ rows[NR] = $0 }
				END {
					for (offset = 0; offset < count; offset++)
						print rows[((start + offset) % count) + 1]
				}' "$DRILL_REPORT.rows" |
			while IFS=' ' read -r REPORT_INDEX REPORT_ROW; do
				printf 'HYPERV_DRILL_REPORT_DATA index=%s data=%s\n' "$REPORT_INDEX" "$REPORT_ROW"
				sleep 0.02
			done
			echo 'HYPERV_DRILL_REPORT end=1'
			REPORT_COPY=$((REPORT_COPY + 1))
		done
	else
		echo 'HYPERV_DRILL_REPORT status=UNAVAILABLE reason=serialization_failed'
	fi
else
	echo 'HYPERV_DRILL_REPORT status=UNAVAILABLE reason=serialization_failed'
fi

emit_status "$RESULT"
echo "HYPERV_DRILL_RESULT lifecycle=$LIFECYCLE_STATUS fragment=$FRAG_STATUS splats=${SPLATS:-0} faults=${FAULTS:-0}"
echo "HYPERV_DRILL_RESULT scope=$SCOPE"
echo "HYPERV_DRILL_SCOPE note=no-co-co-hardware; co-co-chunked-fallback-not-exercised"
for DONE_COPY in 1 2 3; do
	echo "HYPERV_DRILL_DONE"
done

drain_and_poweroff
