diff --git a/drivers/hv/channel.c b/drivers/hv/channel.c
index ee1b132d2649..cfc435424d73 100644
--- a/drivers/hv/channel.c
+++ b/drivers/hv/channel.c
@@ -1160,6 +1160,70 @@ void vmbus_release_buffer(struct vmbus_buffer *buffer)
 }
 EXPORT_SYMBOL_GPL(vmbus_release_buffer);
 
+/**
+ * vmbus_buffer_pin_pages - snapshot a buffer's pages and hold references
+ * @buffer: buffer whose pages the caller is about to map
+ * @pages: out parameter for the page array owned by @buffer
+ * @page_count: out parameter for the number of pages in @pages
+ *
+ * Take a reference on every page of @buffer and hand back the array
+ * that describes them. The references close the window between the
+ * snapshot and the point where a new mapping holds its own: the
+ * reclaim worker refuses to free pages whose folio reference count
+ * is above one, and refuses to start at all once it has begun
+ * reclaiming. Call vmbus_buffer_unpin_pages() after the mapping
+ * holds its own references.
+ *
+ * Return: 0 on success, -ENODEV if the pages are gone or reclaim
+ * has already taken ownership of them.
+ */
+int vmbus_buffer_pin_pages(struct vmbus_buffer *buffer, struct page ***pages,
+			   unsigned long *page_count)
+{
+	struct vmbus_buffer_retained *owner = buffer->owner;
+	u32 i;
+
+	if (!buffer->pages || !buffer->page_cnt)
+		return -ENODEV;
+
+	mutex_lock(&vmbus_buffer_owners_lock);
+	if (owner && (owner->reclaiming || owner->permanent_leak)) {
+		mutex_unlock(&vmbus_buffer_owners_lock);
+		return -ENODEV;
+	}
+
+	for (i = 0; i < buffer->page_cnt; i++) {
+		if (WARN_ON_ONCE(!buffer->pages[i])) {
+			while (i--)
+				put_page(buffer->pages[i]);
+			mutex_unlock(&vmbus_buffer_owners_lock);
+			return -ENODEV;
+		}
+		get_page(buffer->pages[i]);
+	}
+
+	*pages = buffer->pages;
+	*page_count = buffer->page_cnt;
+	mutex_unlock(&vmbus_buffer_owners_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(vmbus_buffer_pin_pages);
+
+/**
+ * vmbus_buffer_unpin_pages - drop references taken by vmbus_buffer_pin_pages
+ * @pages: page array returned by vmbus_buffer_pin_pages
+ * @page_count: number of pages in @pages
+ */
+void vmbus_buffer_unpin_pages(struct page **pages, unsigned long page_count)
+{
+	unsigned long i;
+
+	for (i = 0; i < page_count; i++)
+		put_page(pages[i]);
+}
+EXPORT_SYMBOL_GPL(vmbus_buffer_unpin_pages);
+
 static struct page *vmbus_alloc_pages_node(void *context, int nid,
 					   gfp_t gfp,
 					   unsigned int order)
