+	KUNIT_CASE(hv_uio_mmap_region_select_test),
+	KUNIT_CASE(hv_uio_mmap_prepare_test),
+	{}
+};
+
+static struct kunit_suite hv_uio_ring_mmap_test_suite = {
+	.name = "hyperv-uio-mmap",
