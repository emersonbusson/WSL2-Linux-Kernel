From 623c76cc879601d6eb7c61c3fceda3ef867c8cf9 Mon Sep 17 00:00:00 2001
From: Emerson Busson <emersonbusson@gmail.com>
Date: Thu, 1 Oct 2026 17:22:23 -0300
Subject: [PATCH v2 11/13] hv: vmbus: allocate the requestor array with
 kvcalloc()

__vmbus_open() sizes the per-channel requestor array from the ring
bytes. On netvsc that is netvsc_rqstor_size(), which at the default
ring_size of 128 pages returns enough u64 slots for an array larger
than 256 KiB. kcalloc() then hands the request to get_order(), which
asks for an order-7 compound page.

Under buddy fragmentation that allocation fails while plenty of
virtual memory is free. The visible symptom is exactly the one this
series is about: a dynamically instantiated sub-channel cannot open
and the channel is dead for the life of the fragmentation. On a WSL2
guest the failure prints as

  kworker/...: page allocation failure: order:7, mode:0x40dc0(GFP_KERNEL|__GFP_ZERO|__GFP_COMP)
  Workqueue: hv_sub_chan vmbus_add_channel_work
  ? ___kmalloc_large_node
  ? __kmalloc_noprof
  ? __vmbus_open
  hv_netvsc ... eth0: sub channel open failed: -12

The rings themselves already come from vmbus_alloc_buffer() (patch
1/13), so this removes the order-7 allocation from the open path. A
second, smaller high-order allocation remains there: the RNDIS
request descriptor in rndis_filter.c is larger than
KMALLOC_MAX_CACHE_SIZE and takes an order-2 compound page. That one
is removed in patch 12/13.

The requestor array is guest-private bookkeeping: it stores request
ids the guest hands out and never reaches the host, so it is not
host-visible memory and needs no set_memory_decrypted(). A
vmalloc-backed mapping therefore carries no Confidential Computing
implication, unlike the rings. kvcalloc() is the zeroing counterpart
of kcalloc() and kvcalloc/kvfree are already the pattern this tree
uses for the chunk arrays in vmbus_alloc_buffer().

Free side is kfree(rqstor->req_arr) and the error path in
vmbus_alloc_requestor(); both must become kvfree() because the
allocation may now come from vmalloc.

Revert this patch if a channel open under buddy fragmentation starts
reporting -ENOMEM from vmbus_alloc_requestor() again, or if any path
begins to treat req_arr as host-visible or direct-mapped memory.

Signed-off-by: Emerson Busson <emersonbusson@gmail.com>
---
 drivers/hv/channel.c | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/drivers/hv/channel.c b/drivers/hv/channel.c
index 4f73f0e50537..d71291b95148 100644
--- a/drivers/hv/channel.c
+++ b/drivers/hv/channel.c
@@ -1407,6 +1407,14 @@ EXPORT_SYMBOL_GPL(vmbus_alloc_buffer);
  * keeps track of the next available slot in the array. Initially, each
  * slot points to the next one (as in a Linked List). The last slot
  * does not point to anything, so its value is U64_MAX by default.
+ *
+ * Allocated with kvcalloc() rather than kcalloc(). @size is derived from
+ * the ring size (netvsc_rqstor_size()) and at the default ring_size of
+ * 128 pages the array exceeds 256 KiB, so kcalloc() asks for an order-7
+ * compound page and fails outright under buddy fragmentation. The array
+ * is guest-private request bookkeeping -- the host never sees the slot
+ * values -- so a vmalloc-backed mapping carries no Confidential
+ * Computing implication and needs no set_memory_decrypted().
  * @size: The size of the array
  */
 static u64 *request_arr_init(u32 size)
@@ -1414,7 +1422,7 @@ static u64 *request_arr_init(u32 size)
 	int i;
 	u64 *req_arr;
 
-	req_arr = kcalloc(size, sizeof(u64), GFP_KERNEL);
+	req_arr = kvcalloc(size, sizeof(u64), GFP_KERNEL);
 	if (!req_arr)
 		return NULL;
 
@@ -1443,7 +1451,7 @@ static int vmbus_alloc_requestor(struct vmbus_requestor *rqstor, u32 size)
 
 	bitmap = bitmap_zalloc(size, GFP_KERNEL);
 	if (!bitmap) {
-		kfree(rqst_arr);
+		kvfree(rqst_arr);
 		return -ENOMEM;
 	}
 
@@ -1462,7 +1470,7 @@ static int vmbus_alloc_requestor(struct vmbus_requestor *rqstor, u32 size)
  */
 static void vmbus_free_requestor(struct vmbus_requestor *rqstor)
 {
-	kfree(rqstor->req_arr);
+	kvfree(rqstor->req_arr);
 	bitmap_free(rqstor->req_bitmap);
 }
 
