+static void hv_uio_ring_mmap_prepare_test(struct kunit *test)
+{
+	struct vmbus_channel channel = {
+		.state = CHANNEL_OPENED_STATE,
+		.ringbuffer = {
+			.page_cnt = 8,
+		},
+	};
