+	desc.vma_flags = EMPTY_VMA_FLAGS;
+	KUNIT_EXPECT_EQ(test, hv_uio_ring_mmap_prepare(&channel, &desc), -EINVAL);
+	vma_desc_set_flags(&desc, VMA_SHARED_BIT);
